# Required application settings
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/ai_job_hunter
JWT_SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key

# Job providers. Every provider with valid credentials is searched for each
# saved candidate profile. Leave a provider unset to disable it.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=in

JOOBLE_API_KEY=your-jooble-api-key
# Use the country domain that issued the API key when required.
# JOOBLE_BASE_URL=https://in.jooble.org/api
